.idea
target

# Tracy CPU profiles — large, regenerated on demand. Saved to repo root
# during perf investigations but never meant to be checked in.
*.tracy
*.tracy.zstd
*.zstd

# Server runtime state: the character store and its WAL.
characters.sqlite*

# vmangos and DBC exports, pointed at by [world] data_dir.
*.sqlite

# The world's data where the server and the tests look for it. data/db's two
# databases ship with the repository (Git LFS); data/nav and data/terrain are
# made from each user's own client.
!/data/db/vmangos.sqlite
!/data/db/dbc.sqlite
/data/nav
/data/terrain
# The start's offer to build them, declined: not asked again while it's there.
/data/setup-declined.txt

# Python bytecode cache (tools/client_check and the like).
__pycache__/

# Per-user the orchestrator state (scheduled tasks, locks, plans, etc.).
.claude/

# A local environment file (the server doesn't read one; a shell may
# source it). Never commit.
.env

# Extracted client game data. Everyone extracts their own.
Data/

# Reference clone of cmangos used for architecture comparison. Its own repo.
mangos-classic/
